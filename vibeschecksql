

DROP TABLE IF EXISTS songs;
CREATE TABLE songs(
song_id INTEGER PRIMARY KEY,
title VARCHAR(50) NOT NULL,
artist VARCHAR(40) NOT NULL,
genre VARCHAR(20),
mood VARCHAR(20),
streams_m DECIMAL(6,1) DEFAULT 0,
release_year INTEGER,
duration_sec INTEGER
);
