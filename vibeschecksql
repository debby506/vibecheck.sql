--SELECT all column from the songs table
SELECT * FROM songs;
--SELECT title, artist FROM songs
SELECT title, artist FROM songs;
--SELECT Gym FROM the songs table
SELECT title, artist FROM songs WHERE mood='Gym';
--SELECT songs with streams_m more than 100 
SELECT * FROM songs WHERE streams_m>100;
--SELECT songs released in 2025
SELECT * FROM songs WHERE release_year =2025;
--SELECT where mood is hype and shorter than 200 sec
SELECT title, duration_sec FROM  songs WHERE mood='Hype' AND duration_sec < 200;
--SELECT songs by Zuri K or Wanjiru
SELECT * FROM songs WHERE artist ='Zuri K' OR artist = 'Wanjiru';
--SELECT WHERE genre IS Hip-Hop OR Gengetone night
SELECT * FROM songs WHERE genre IN ('Hip-Hop', 'Gengetone');
--SELECT WHERE SONGS released between 2022 to 2023
SELECT * FROM songs  WHERE release_year BETWEEN 2022 AND 2023;
--Title starting with letter M
SELECT * FROM songs WHERE title LIKE 'M%';
--SELECT 5 most streamed songs,biggest first
SELECT genre, streams_m FROM songs ORDER BY streams_m DESC LIMIT 5;
--SELECT genre FROM songs
SELECT DISTINCT genre FROM songs;
--SELECT total number of songs
SELECT COUNT (*) AS total_songs FROM songs;
--SELECT total streams_m rounded to 1 DECIMAL
SELECT ROUND(SUM(streams_m), 1) AS total_streams_m FROM songs;
--SELECT average streams_m per song rounded to 1 DECIMAL
SELECT ROUND(AVG(streams_m),1) AS average_streams_m FROM songs;
--SELECT biggest and Smallest streams_m
SELECT MAX(streams_m) AS biggest, MIN(streams_m) AS Smallest FROM songs;
--SELECT song title with its length in minutes
SELECT title, ROUND(duration_sec/60.0,1) AS minutes FROM songs;
--Display how many songs each genre has
SELECT genre, COUNT (*) AS total_songs FROM songs GROUP BY genre;
